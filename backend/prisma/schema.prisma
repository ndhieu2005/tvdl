generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admins {
  id            Int       @id @default(autoincrement())
  username      String    @unique @db.VarChar(50)
  password_hash String    @db.VarChar(255)
  created_at    DateTime  @default(now())
  deleted_at    DateTime?
}

model Age_Groups {
  id         Int          @id @default(autoincrement())
  name       String       @unique @db.VarChar(50)
  deleted_at DateTime?
  categories       Categories[]
  book_suggestions Book_Suggestions[]
  events           Events[]
}

model Categories {
  id           Int         @id @default(autoincrement())
  age_group_id Int
  name         String      @db.VarChar(100)
  deleted_at   DateTime?
  age_group    Age_Groups  @relation(fields: [age_group_id], references: [id])
  books            Books[]
  new_books        New_Books[]
  book_suggestions Book_Suggestions[]
}

model Locations {
  id                 Int                  @id @default(autoincrement())
  name               String               @unique @db.VarChar(100)
  type               String               @db.VarChar(50)
  color_code         String?              @db.VarChar(10)
  deleted_at         DateTime?
  books              Books[]
  new_books          New_Books[]
  schedule_templates Schedule_Templates[]
  schedules          Schedules[]
  events             Events[]
}

model Readers {
  id          Int        @id @default(autoincrement())
  reader_code String     @unique @db.VarChar(50)
  full_name   String?    @db.VarChar(255)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  deleted_at  DateTime?
  book_suggestions Book_Suggestions[]
}

model Books {
  id          Int        @id @default(autoincrement())
  book_code   String     @unique @db.VarChar(50)
  title       String     @db.VarChar(255)
  author      String     @db.VarChar(40)
  cover_url   String?    @db.VarChar(255)
  location_id Int
  category_id Int
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  deleted_at  DateTime?
  location    Locations  @relation(fields: [location_id], references: [id])
  category    Categories @relation(fields: [category_id], references: [id])
}

model New_Books {
  id                Int        @id @default(autoincrement())
  title             String     @db.VarChar(255)
  author            String?    @db.VarChar(255)
  cover_image       String?    @db.VarChar(255)
  short_description String?    @db.Text
  location_id       Int
  category_id       Int
  created_at        DateTime   @default(now())
  updated_at        DateTime   @updatedAt
  deleted_at        DateTime?
  location          Locations  @relation(fields: [location_id], references: [id])
  category          Categories @relation(fields: [category_id], references: [id])
}

model Book_Suggestions {
  id           Int         @id @default(autoincrement())
  reader_code  String      @db.VarChar(50)
  email        String?     @db.VarChar(255)
  book_name    String?     @db.VarChar(255)
  category_id  Int?
  age_group_id Int?
  description  String?     @db.Text
  created_at   DateTime    @default(now())
  reader       Readers     @relation(fields: [reader_code], references: [reader_code])
  category     Categories? @relation(fields: [category_id], references: [id])
  age_group    Age_Groups? @relation(fields: [age_group_id], references: [id])
}

model Schedule_Templates {
  id                   Int       @id @default(autoincrement())
  day_of_week          Int
  shift                String    @db.VarChar(20)
  time_frame           String    @db.VarChar(50)
  location_id          Int
  custom_location_name String?   @db.VarChar(255)
  location             Locations @relation(fields: [location_id], references: [id])
}

model Schedules {
  id                   Int       @id @default(autoincrement())
  date                 DateTime  @db.Date
  shift                String    @db.VarChar(20)
  time_frame           String    @db.VarChar(50)
  location_id          Int
  custom_location_name String?   @db.VarChar(255)
  is_sudden_closed     Boolean   @default(false)
  closed_reason        String?   @db.Text
  location             Locations @relation(fields: [location_id], references: [id])
}

model Events {
  id                   Int         @id @default(autoincrement())
  name                 String      @db.VarChar(255)
  event_datetime       DateTime
  location_id          Int?
  target_age_group_id  Int?
  seat_count           Int?
  custom_location_name String?     @db.VarChar(255)
  organizer            String?     @db.VarChar(255)
  description          String?     @db.Text
  created_at           DateTime    @default(now())
  updated_at           DateTime    @updatedAt
  deleted_at           DateTime?
  location             Locations?  @relation(fields: [location_id], references: [id])
  target_age_group     Age_Groups? @relation(fields: [target_age_group_id], references: [id])
}
